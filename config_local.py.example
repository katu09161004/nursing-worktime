# config_local.py — 施設固有・非公開のサンプル。
# このファイル(.example)はサンプルなので汎用値のみ。実値は書かない。
# 使い方: コピーして config_local.py を作り、そこに実値を書く（config_local.py は .gitignore 済み）。
#   cp config_local.py.example config_local.py
# 病棟名・スタッフID・DBパスワードなど施設固有情報は config_local.py にのみ書き、
# 絶対にこのサンプルや公開リポジトリのファイルに書かないこと。
WARDS  = ["病棟A", "病棟B", "その他"]
SHIFTS = ["日勤", "夜勤", "早出", "遅出"]
# 従業員番号を自由入力する運用では STAFF は使われない（記録画面は入力欄）。
# 旧来のプルダウン運用に戻す場合の候補としてのみ残す。
STAFF  = ["N-01", "N-02", "N-03", "N-04", "N-05"]

# PostgreSQL 接続（Webアプリ・Excel 共通の1つのDB）
DB = {
    "backend": "postgres",
    "host":    "127.0.0.1",
    "port":    5432,
    "dbname":  "worktime",
    "user":    "nwt",
    "password": "ここにパスワード",
}
# ※ backend を外す or "sqlite" にすると従来のSQLite（worktime.db）で動く

# 音声打刻のAI解釈（任意）。設定するとインターネット公開側で言い換え・意図まで拾える。
# 既定はさくらのAI Engine（OpenAI互換・国内DC完結・月3,000回無料枠）。
# 未設定なら記録画面は端末内の「読み・別名＋あいまい一致」のみで動く（外部送信なし）。
# 院内LAN専用サーバ（外部通信不可）では設定しないこと。
