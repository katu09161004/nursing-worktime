# config_local.py — 施設固有・非公開のサンプル。
# このファイル(.example)はサンプルなので汎用値のみ。実値は書かない。
# 使い方: コピーして config_local.py を作り、そこに実値を書く（config_local.py は .gitignore 済み）。
#   cp config_local.py.example config_local.py
# 病棟名・スタッフID・DBパスワードなど施設固有情報は config_local.py にのみ書き、
# 絶対にこのサンプルや公開リポジトリのファイルに書かないこと。
WARDS  = ["病棟A", "病棟B", "その他"]
SHIFTS = ["日勤", "夜勤", "早出", "遅出"]
# 従業員番号を自由入力する運用では STAFF は使われない（記録画面は入力欄）。
# 旧来のプルダウン運用に戻す場合の候補としてのみ残す。
STAFF  = ["N-01", "N-02", "N-03", "N-04", "N-05"]

# PostgreSQL 接続（Webアプリ・Excel 共通の1つのDB）
DB = {
    "backend": "postgres",
    "host":    "127.0.0.1",
    "port":    5432,
    "dbname":  "worktime",
    "user":    "nwt",
    "password": "ここにパスワード",
}
# ※ backend を外す or "sqlite" にすると従来のSQLite（worktime.db）で動く

# ============================================================
# 音声打刻（記録画面の「🎤 音声で打刻」）
# ------------------------------------------------------------
# 部品は3つ：
#   ① 音声認識(STT)   … 音声→テキスト
#   ② AI解釈(VOICE)   … テキスト→業務区分（言い換え・意図を吸収。任意）
#   ③ 音声出力/ビープ … 端末のTTS + WebAudio（設定不要・常に有効）
# ①②とも未設定なら、端末内の「読み・別名＋あいまい一致」だけで動く（外部送信なし）。

# --- ① 音声認識(STT) ---
# 既定は "webspeech"（ブラウザ内蔵の音声認識＝Google/Apple、要インターネット）。VPS向け。
# 院内オフラインは "whisper"：端末で録音し、オンプレの文字起こしサーバへPOSTする。
#   例（DL380：nginxで /nwt-stt/transcribe を aqua-stt(:8080)/transcribe に同一オリジンproxy）
# STT = {"mode": "whisper", "url": "/nwt-stt/transcribe", "field": "audio"}

# --- ② AI解釈(VOICE)。OpenAI互換の /chat/completions を叩く ---
# インターネット公開側（VPS）＝さくらのAI Engine（国内DC完結・月3,000回無料枠）:
# VOICE = {
#     "api_key": "ここにさくらのAI EngineのAPIキー(UUID)",
#     "base_url": "https://api.ai.sakura.ad.jp/v1",   # 省略時この値
#     "model": "gpt-oss-120b",                        # 反応の良い別モデルに変更可
# }
# 院内オフライン（DL380）＝ローカルのOllama（外部通信なし。api_keyはダミーでよい）:
# VOICE = {
#     "api_key": "ollama",
#     "base_url": "http://127.0.0.1:11434/v1",
#     "model": "qwen2.5:7b-instruct",
# }
# ※ マイクはHTTPS(secure context)必須。院内は自己署名HTTPSのポートで配信すること。
