[Unit]
Description=看護業務量調査ツール (nursing work-time logger)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 配置先とユーザーは環境に合わせて変更する
User=katu
Group=katu
WorkingDirectory=/opt/nursing-worktime
ExecStart=/opt/nursing-worktime/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8301
Restart=on-failure
RestartSec=5

# worktime.db への書き込みのみ許可し、それ以外は読み取り専用にする
ProtectSystem=strict
ReadWritePaths=/opt/nursing-worktime
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
